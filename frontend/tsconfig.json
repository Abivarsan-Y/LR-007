{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "src/scene/preview-app",
    "src/scene/dist",
    "src/scene/node_modules",
    "src/scene/*.test.mjs",
    "src/scene/vite.config.mjs"
  ]
}
