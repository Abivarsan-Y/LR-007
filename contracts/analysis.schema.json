{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:horizon-ops:analysis:0.1.0",
  "title": "HORIZON OPS analysis draft contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "data_kind": {
          "enum": [
            "synthetic",
            "cached_real",
            "live_real"
          ]
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "uri",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "data_kind",
        "model_version",
        "sources",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevation_m": {
          "type": "number"
        },
        "frame": {
          "const": "MOON_ME_DE421"
        },
        "reference_radius_m": {
          "const": 1737400
        }
      },
      "required": [
        "latitude_deg",
        "longitude_deg",
        "elevation_m",
        "frame",
        "reference_radius_m"
      ],
      "additionalProperties": false
    },
    "start_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "end_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "observer_height_m": {
      "type": "number",
      "minimum": 0
    },
    "sample_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "utc": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "met_hours": {
            "type": "number",
            "minimum": 0
          },
          "sun": {
            "type": "object",
            "properties": {
              "azimuth_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              "elevation_deg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "angular_diameter_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 180
              },
              "horizon_deg": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "visible": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "illumination_fraction": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "azimuth_deg",
              "elevation_deg",
              "angular_diameter_deg",
              "horizon_deg",
              "visible",
              "illumination_fraction"
            ],
            "additionalProperties": false
          },
          "earth": {
            "type": "object",
            "properties": {
              "azimuth_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              "elevation_deg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "angular_diameter_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 180
              },
              "horizon_deg": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "visible": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "azimuth_deg",
              "elevation_deg",
              "angular_diameter_deg",
              "horizon_deg",
              "visible"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "utc",
          "met_hours",
          "sun",
          "earth"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "horizon": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "azimuth_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "elevation_deg": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              {
                "type": "null"
              }
            ]
          },
          "coverage": {
            "enum": [
              "complete",
              "unknown"
            ]
          }
        },
        "required": [
          "azimuth_deg",
          "elevation_deg",
          "coverage"
        ],
        "additionalProperties": false
      }
    },
    "slope": {
      "type": "object",
      "properties": {
        "angle_deg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "screening_status": {
          "enum": [
            "SAFE",
            "CAUTION",
            "HAZARD",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "angle_deg",
        "screening_status"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "sunlight_hours": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sunlight_fraction": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "max_darkness_hours": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "earth_visible_hours": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "earth_visible_fraction": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "max_earth_occlusion_hours": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "both_visible_hours": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sunlight_hours",
        "sunlight_fraction",
        "max_darkness_hours",
        "earth_visible_hours",
        "earth_visible_fraction",
        "max_earth_occlusion_hours",
        "both_visible_hours"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "provenance",
    "analysis_id",
    "site_id",
    "coordinates",
    "start_utc",
    "end_utc",
    "observer_height_m",
    "sample_minutes",
    "samples",
    "horizon",
    "slope",
    "metrics"
  ],
  "additionalProperties": false
}
